APP_ENV=development
APP_ADDRESS=127.0.0.1:3000
APP_BASE_URL=http://127.0.0.1:3000
DATABASE_URL=sqlite://store.db?mode=rwc
BOOTSTRAP_ADMIN_PASSWORD=

# Local default prints a one-time confirmation link to the server log and page.
EMAIL_MODE=console
# To send real email, set EMAIL_MODE=smtp and configure all SMTP values.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Test keys only. Keep the secret key in this server-side environment file.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
